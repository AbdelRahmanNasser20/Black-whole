# Copy to .env and fill in values.

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM: openai | ollama | groq | claude_max
#
# RECOMMENDED: groq — free tier, fast, llama-3.3-70b reliably follows JSON
#   instructions. Sign up at https://console.groq.com → API Keys.
#
# ALTERNATIVE: claude_max — uses your Claude Max subscription via the official
#   claude-agent-sdk. No API key needed, no extra spend, but counts against your
#   5-hour Max message quota and is slower (subprocess + agent overhead).
#   Requires: `npm install -g @anthropic-ai/claude-code` and `claude` already
#   logged in. Override the model with CLAUDE_MAX_MODEL=claude-opus-4-6 etc.
LLM_PROVIDER=groq

# Groq (when LLM_PROVIDER=groq)
GROQ_API_KEY=

# Claude Max (when LLM_PROVIDER=claude_max)
# CLAUDE_MAX_MODEL=claude-sonnet-4-5

# OpenAI (when LLM_PROVIDER=openai)
# OPENAI_API_KEY=

# Ollama (when LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# Seconds for /api/chat (ranking large JSON can be slow on CPU; default 600)
# OLLAMA_TIMEOUT=600

# Server / CI: run browser headless
# HEADLESS=1

# GovDeals Playwright: use direct browse/search URL (recommended; avoids homepage search box issues)
# Default site entry is https://www.govdeals.com/en (override only if GovDeals changes locales)
# GOVDEALS_SITE_ORIGIN=https://www.govdeals.com/en
# GOVDEALS_USE_BROWSE_SEARCH_URL=1
# GOVDEALS_GOTO_TIMEOUT_MS=90000
# Optional: override Chrome UA if Akamai blocks the default fingerprint
# GOVDEALS_USER_AGENT=Mozilla/5.0 ...
# Extra chromium flags (space-separated)
# GOVDEALS_CHROMIUM_ARGS=

# GovDeals only — optional quantity pipeline (see README)
# Open each asset page and scrape long description (slow; polite delay between pages)
# FETCH_GOVDEALS_DESCRIPTION=1
# FETCH_GOVDEALS_DELAY_SEC=0.35
# Batch LLM to infer chair count from title + description (uses same LLM_PROVIDER).
# Defaults ON; set to 0 to ship the brittle title-regex quantities instead.
# USE_LLM_QUANTITY=0
# LLM_QUANTITY_CHUNK=12

# SQLite cache (state/listings.db) — automatic, on by default.
# Skips the slow per-listing description fetch when an asset_id is already cached.
# LISTINGS_DB_PATH=state/listings.db        # override path
# LISTINGS_DB_DISABLE=1                     # turn the cache off entirely
# FETCH_GOVDEALS_FORCE_REFRESH=1            # ignore cached descriptions for this run

# BidSpotter (bidspotter_automation.py) — plain HTTP, no browser.
# Reuses the shared USE_LLM_QUANTITY / QUANTITY_LLM_PROVIDER / Telegram / INCLUDE_MEDICAL vars.
# Comma-separated search terms (default: chairs)
# BIDSPOTTER_SEARCH_TERMS=chairs
# Cards per page via the pagesize cookie (site honors 120)
# BIDSPOTTER_PAGE_SIZE=120
# Hard cap on pages per term (data-pages is read from each response)
# BIDSPOTTER_MAX_PAGES=20
# Polite delay between page fetches (seconds)
# BIDSPOTTER_HTTP_DELAY_SEC=0.5
# AWS-WAF 202-challenge retries + linear backoff base (seconds)
# BIDSPOTTER_WAF_RETRIES=4
# BIDSPOTTER_WAF_BACKOFF_SEC=2
# Keep `live`-auction lots in ranking/alerts (they are always archived;
# their prices cannot be polled). 0 = timed-only alerts.
# BIDSPOTTER_INCLUDE_LIVE=1
